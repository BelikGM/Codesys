# ── Мусор CODESYS ────────────────────────────────────────────
# Резервные копии, которые среда кладёт рядом с проектом
*.project~
*.projectarchive~
*.~u
*.~ur
*.bak

# Сессионные и пользовательские настройки — у каждого свои,
# в общий репозиторий не идут
*.opt
*.opt.*
*.project.opt

# Автосохранения и аварийные дампы
*.autosave
*.core
*.dmp

# Папки, которые CODESYS создаёт при компиляции и архивации
_backup/
_temp/
compare/

# ── Прочее ───────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
