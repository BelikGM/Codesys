(* ============================================================ *)
(* E_PumpType — тип преобразователя частоты ELHART             *)
(* ============================================================ *)
(* === ИЗМЕНЕНО === MINI удалён (в проектах его не было — была   *)
(* ошибка типа). Теперь два типа: PUMP (EMD-PUMP) и VL           *)
(* (EMD-VL/VH, векторный). Обработка обоих — в FB_Pump.          *)
(*                                                              *)
(* Тип каждого ПЧ задаётся в массиве GVL.ePumpType[1..cPumpCount] *)
(* (RETAIN). Автоопределение PUMP/VL по сигнатурному регистру —   *)
(* см. комментарий в PRG_Pumps (пока задаётся вручную).          *)
(* ============================================================ *)
TYPE E_PumpType :
(
    PUMP := 0,   // EMD-PUMP (F-коды, задание частоты в Гц ×100 → 0x2001)
    VL   := 1    // EMD-VL (P-группы, задание в % → 0x1000, статус 0x3000)
);
END_TYPE
