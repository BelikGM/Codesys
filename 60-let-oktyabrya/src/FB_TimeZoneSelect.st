(* ================================================================
   FB_TimeZoneSelect — Выбор часового пояса комбобоксом
   Без изменений относительно проекта ДДЮТ.

   ChoseTimeZone — индекс 0-23 с экрана (Текстовый список).
   Линейная зависимость: TimeZone = ChoseTimeZone - 11.
   ChoseTimeZone = 14 → TimeZone = +3 (Москва) — ЗНАЧЕНИЕ ПО
   УМОЛЧАНИЮ.

   На экране "Текстовый список", строки:
   0  → "-11 Паго-Паго"          12 → "+1  Берлин"
   1  → "-10 Гонолулу"           13 → "+2  Калининград"
   2  → "-9  Анкоридж"           14 → "+3  Москва"   ← ПО УМОЛЧАНИЮ
   3  → "-8  Лос-Анджелес"       15 → "+4  Самара"
   4  → "-7  Денвер"             16 → "+5  Екатеринбург"
   5  → "-6  Мехико"             17 → "+6  Омск"
   6  → "-5  Нью-Йорк"           18 → "+7  Красноярск"
   7  → "-4  Сантьяго"           19 → "+8  Иркутск"
   8  → "-3  Буэнос-Айрес"       20 → "+9  Якутск"
   9  → "-2  Норонья"            21 → "+10 Владивосток"
   10 → "-1  Азорские о-ва"      22 → "+11 Магадан"
   11 → "0   Лондон"             23 → "+12 Камчатка"
   ================================================================ *)

FUNCTION_BLOCK FB_TimeZoneSelect
VAR_INPUT
    ChoseTimeZone   : UDINT;  (* Индекс выбора, 0-23. По умолчанию 14=Москва *)
END_VAR
VAR_OUTPUT
    TimeZone        : REAL;   (* → вход TimeZone в FB_SunsetRelay             *)
END_VAR
VAR
    idx             : UDINT;
END_VAR

IF ChoseTimeZone > 23 THEN
    idx := 14;
ELSE
    idx := ChoseTimeZone;
END_IF;

TimeZone := UDINT_TO_REAL(idx) - 11.0;
