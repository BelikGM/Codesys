(* ============================================================ *)
(* PRG_IO — распаковка входов МВ110, сборка выходов МУ110       *)
(* === 60ЛО: НОВАЯ КАРТА ("60 Лет Октября") ===                 *)
(*                                                              *)
(* КАРТА DI (МВ110-16Д):                                       *)
(*   DI1  ПЧ1 (насос-шоу, информационный, ни на что не влияет) *)
(*   DI2  ПЧ2 (насос-шоу, информационный)                      *)
(*   DI3  ПЧ3 (насос-шоу, информационный, НОВЫЙ)                *)
(*   DI4  Сухой ход от Мусидоры (1=норма)                       *)
(*   DI5  Пуск добора от Мусидоры (автоматика, мы не решаем)    *)
(*   DI6  Подтверждение положения клапана добора                *)
(*   DI7  Контактор фильтрации (НФ физически работает)          *)
(*   DI8  Подтверждение реле сухого хода                        *)
(*   DI9  Подтверждение работы насосов фонтана                  *)
(*   DI10 Подтверждение работы подсветки                        *)
(*   DI11 Ручка режима фильтрации = АВТО                        *)
(*   DI12 Ручка режима фильтрации = РУЧНОЙ                      *)
(*                                                              *)
(* КАРТА DO (МУ110-16Р):                                       *)
(*   DO1  дубляж сухого хода (=DI4)                             *)
(*   DO2  пуск насосов фонтана                                  *)
(*   DO3  пуск подсветки                                        *)
(*   DO4  дубляж клапана добора (=DI5)                          *)
(*   DO5..DO16 — свободны                                       *)
(* Семантическая распаковка DI и сборка DO — в PRG_Fountain     *)
(* (блоки 2 и 15). Здесь только упаковка/распаковка сырых        *)
(* массивов xDI[]/xDO[], логика тела программы НЕ МЕНЯЛАСЬ.      *)
(* ============================================================ *)
PROGRAM PRG_IO
VAR
    i : INT;
    tonMU110SafeInit   : TON;
    xMU110SafeInitDone : BOOL := FALSE;
    tonMV110Hold       : TON;          // удержание входов при сбое связи МВ110
    tDI_Hold           : TIME := T#10S; // время удержания входов
END_VAR
(* Безопасное состояние МУ110: через 3 сек после старта         *)
(* однократно взводим триггер записи (все выходы=0 при потере   *)
(* связи мастер↔МУ110).                                         *)
tonMU110SafeInit(IN := NOT xMU110SafeInitDone, PT := T#3S);
IF tonMU110SafeInit.Q AND NOT xMU110SafeInitDone THEN
    xMU110_WriteSafe   := TRUE;
    xMU110SafeInitDone := TRUE;
ELSE
    xMU110_WriteSafe := FALSE;
END_IF;

(* Входы МВ110 → xDI[1..16]. Удержание последнего значения при   *)
(* кратком сбое связи (tDI_Hold). Логика не меняется.          *)
tonMV110Hold(IN := xMV110_Error, PT := tDI_Hold);

IF xMV110_Error AND tonMV110Hold.Q THEN
    FOR i := 1 TO cDI_Count DO
        xDI[i] := FALSE;
    END_FOR;
ELSIF NOT xMV110_Error THEN
    FOR i := 1 TO cDI_Count DO
        xDI[i] := (wMV110_Inputs AND SHL(WORD#1, INT_TO_BYTE(i - 1))) <> WORD#0;
    END_FOR;
END_IF;

(* Распаковка семантических DI делается в PRG_Fountain блок 2.  *)
(* Здесь только заполняем массив xDI[].                          *)

(* Выходы xDO[1..16] → маска МУ110. При потере связи — 0.       *)
IF xMU110_Error THEN
    wMU110_Outputs := 0;
ELSE
    wMU110_Outputs := 0;
    FOR i := 1 TO cDO_Count DO
        IF xDO[i] THEN
            wMU110_Outputs := wMU110_Outputs OR SHL(WORD#1, INT_TO_BYTE(i - 1));
        END_IF;
    END_FOR;
END_IF;
