(* ============================================================ *)
(* PRG_IO_Write — СБОРКА маски выходов МУ110 из xDO[]           *)
(* === 60ЛО:НОВЫЙ POU === Выделен из PRG_IO, чтобы устранить     *)
(* задержку на 1 скан. Вызывается в PLC_PRG ПОСЛЕ PRG_Fountain,  *)
(* поэтому xDO[] здесь — уже посчитанные значения ЭТОГО цикла.   *)
(*                                                              *)
(* Логика полностью перенесена из старого PRG_IO без изменений:  *)
(* при потере связи с МУ110 маска = 0 (все выходы выключены).    *)
(* ============================================================ *)
PROGRAM PRG_IO_Write
VAR
    i : INT;
END_VAR

(* Выходы xDO[1..16] → маска МУ110. При потере связи — 0. *)
IF xMU110_Error THEN
    wMU110_Outputs := 0;
ELSE
    wMU110_Outputs := 0;
    FOR i := 1 TO cDO_Count DO
        IF xDO[i] THEN
            wMU110_Outputs := wMU110_Outputs OR SHL(WORD#1, INT_TO_BYTE(i - 1));
        END_IF;
    END_FOR;
END_IF;
