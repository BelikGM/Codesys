(* ================================================================
   FB_TimeZoneSelect — Выбор часового пояса комбобоксом
   === ДДЮТ:НОВЫЙ ФАЙЛ === Без технических изменений — синтаксис
   уже совместим с CODESYS 3.5 (нет SYS.* функций OwenLogic).

   ChoseTimeZone — индекс 0-23 с экрана (Текстовый список).
   Линейная зависимость: TimeZone = ChoseTimeZone - 11.
   ChoseTimeZone = 14 → TimeZone = +3 (Москва) — ЗНАЧЕНИЕ ПО
   УМОЛЧАНИЮ. Если оператор ничего не выберет — расчёт всё равно
   будет верным для объекта в РФ/Крыму, а не съедет на Гринвич.

   На экране создать «Текстовый список», привязанный к
   ChoseTimeZone, со строками:
   0  → "-11 Паго-Паго"
   1  → "-10 Гонолулу"
   2  → "-9  Анкоридж"
   3  → "-8  Лос-Анджелес"
   4  → "-7  Денвер"
   5  → "-6  Мехико"
   6  → "-5  Нью-Йорк"
   7  → "-4  Сантьяго"
   8  → "-3  Буэнос-Айрес"
   9  → "-2  Норонья"
   10 → "-1  Азорские о-ва"
   11 → "0   Лондон"
   12 → "+1  Берлин"
   13 → "+2  Калининград"
   14 → "+3  Москва"           ← ЗНАЧЕНИЕ ПО УМОЛЧАНИЮ
   15 → "+4  Самара"
   16 → "+5  Екатеринбург"
   17 → "+6  Омск"
   18 → "+7  Красноярск"
   19 → "+8  Иркутск"
   20 → "+9  Якутск"
   21 → "+10 Владивосток"
   22 → "+11 Магадан"
   23 → "+12 Камчатка"
   ================================================================ *)

FUNCTION_BLOCK FB_TimeZoneSelect
VAR_INPUT
    ChoseTimeZone   : UDINT;  (* Индекс выбора, 0-23. По умолчанию 14=Москва *)
END_VAR
VAR_OUTPUT
    TimeZone        : REAL;   (* → вход TimeZone в FB_SunsetRelay             *)
END_VAR
VAR
    idx             : UDINT;  (* Рабочая копия для проверки диапазона        *)
END_VAR

(* Защита от некорректного значения (>23) — откат на Москву (14) *)
IF ChoseTimeZone > 23 THEN
    idx := 14;
ELSE
    idx := ChoseTimeZone;
END_IF;

(* Линейное преобразование: индекс 0..23 → смещение -11..+12 *)
TimeZone := UDINT_TO_REAL(idx) - 11.0;

END_FUNCTION_BLOCK
