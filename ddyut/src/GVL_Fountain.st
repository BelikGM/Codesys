(* ============================================================ *)
(* GVL_Fountain — переменные автоматики фонтана ДДЮТ            *)
(* (на основе Fontan_V1 / Саки Пруд)                            *)
(*                                                              *)
(* === ГЛАВНЫЕ ОТЛИЧИЯ ОТ САКИ ===                              *)
(*  - Уровень чаши: ДВА дискретных входа (DI7 нижний, DI8       *)
(*    верхний) вместо аналогового 4-20мА. Нет ямы слива.        *)
(*  - Сухой ход — отдельный вход DI6, не расчёт по см.          *)
(*  - Фильтрация: контактор фильтр.насоса на DI5 отдельно от    *)
(*    насосов COM2 (те теперь качают фонтан, не фильтруют).     *)
(*  - Нет ПР200 и резерва полива СПК (файлы сохранены, не       *)
(*    вызываются — легко вернуть).                              *)
(*  - Расчёт заката — новый (NOAA, FB_SunsetRelay), не завязан   *)
(*    ни на один DI.                                            *)
(*                                                              *)
(* КАРТА ВЫХОДОВ DO (МУ110-16Р, COM1, адрес 2):                 *)
(*   DO1  — СВЕТ                                                *)
(*   DO2  — ЛАМПА АВАРИИ (мигает)                                *)
(*   DO3..DO8, DO10, DO12 — свободны (FALSE)                    *)
(*   DO9  — НАСОСЫ ФОНТАНА                                      *)
(*   DO11 — КЛАПАН ДОБОРА (заслонка)                            *)
(*   DO13 — "сухой ход/разрешение": 1=норма, 0=авария добора    *)
(*          (после исчерпания попыток), см. PRG_Fountain блок 7 *)
(*   DO14 — АЛЬГИЦИД                                             *)
(*   DO15 — БИОПАГ / ОБЕЗЗАРАЖИВАТЕЛЬ                            *)
(*   DO16 — pH                                                  *)
(*                                                              *)
(* КАРТА ВХОДОВ DI (МВ110-16Д, COM1, адрес 1):                  *)
(*   DI1  — ПЧ1 насос фонтана (работа)                          *)
(*   DI2  — ПЧ2 насос фонтана (работа)                          *)
(*   DI3  — разрешение работы частотников                       *)
(*   DI4  — контактор УФ (мониторинг, выхода на УФ нет)         *)
(*   DI5  — контактор фильтр.насоса (наработка НФ)               *)
(*   DI6  — реле СУХОГО ХОДА (1 = вода есть)                    *)
(*   DI7  — УРОВЕНЬ 1 нижний  (0 = нужен добор)                 *)
(*   DI8  — УРОВЕНЬ 2 верхний (1 = стоп добора)                 *)
(*   DI9  — подтверждение работы pH                             *)
(*   DI10 — подтверждение работы биопаг                         *)
(*   DI11 — подтверждение работы альгицид                       *)
(*   DI12..DI16 — свободны                                       *)
(* ============================================================ *)

VAR_GLOBAL CONSTANT
    (* === ДДЮТ:УДАЛИТЬ — шкала уровня чаши по AI1 не нужна === *)
    (* Уровень чаши теперь дискретный (DI7/DI8), нет 4-20мА.     *)
    (*
    cWaterRawMin : REAL := 4.0;
    cWaterRawMax : REAL := 20.0;
    cWaterCmMin  : REAL := 0.0;
    cWaterCmMax  : REAL := 100.0;
    *)

    (* === ДДЮТ: ОСТАВЛЕНО АКТИВНЫМ === Используется только      *)
    (* файлом PRG_PolivSPK.st (сохранён, не вызывается на ДДЮТ,  *)
    (* т.к. нет ямы слива). Оставлено, чтобы файл не переставал   *)
    (* компилироваться. Если PRG_PolivSPK.st будет физически      *)
    (* удалён из проекта — эти константы тоже можно убрать.       *)
    cSlivRawMin : REAL := 4.0;
    cSlivRawMax : REAL := 20.0;
    cSlivCmMin  : REAL := 0.0;
    cSlivCmMax  : REAL := 100.0;
END_VAR


VAR_GLOBAL RETAIN
    (* === ДДЮТ:ИЗМЕНЕНО (round 7, ФИНАЛЬНАЯ СХЕМА) — ЖУРНАЛ ИЗМЕНЕНИЙ       *)
    (* ПАРАМЕТРОВ ФОНТАНА ===                                                 *)
    (* Причина, почему это массив, а не одна строка — см. round 6: WCONCAT в *)
    (* CODESYS официально ограничен 255 символами возврата, независимо от     *)
    (* объявленного размера WSTRING (https://content.helpme-codesys.com/en/  *)
    (* CODESYS String Libraries/_strlib_start_page.html).                    *)
    (* === ДДЮТ:ИЗМЕНЕНО (round 7) === СХЕМА СДВИГА (новое): позиция 1 —      *)
    (* ВСЕГДА самая последняя запись. При каждой новой записи всё, что было,  *)
    (* сдвигается на 1 позицию вниз (2→3, 1→2), новая запись садится на       *)
    (* позицию 1. Когда достигнут предел (60) — самая старая запись           *)
    (* (позиция 60) при сдвиге просто "выпадает" из массива. Это устраняет    *)
    (* необходимость в НА ЭКРАНЕ вычисляемых индексах вида                    *)
    (* "aFountainLog[iFountainLogCount-k]" — ИМЕННО такие вычисляемые         *)
    (* индексы, судя по всему, и давали "путаницу переменных" (при           *)
    (* iFountainLogCount меньше, чем число видимых на экране строк, индекс    *)
    (* уходил в 0 или отрицательное число — обращение к несуществующему       *)
    (* элементу массива в CODESYS не ошибка компиляции, а чтение "что         *)
    (* попало" из соседней памяти). Теперь на экране — ВСЕГДА статичные       *)
    (* константы 1, 2, 3... — вне диапазона массива уйти невозможно.          *)
    (* Размер: 60 записей, длина ячейки 60 символов (по прямому запросу).    *)
    (* ⚠️ С полными названиями + единицы измерения у обоих значений + пробелы*)
    (* вокруг стрелки — для записей с REAL (доза/расход, REAL_TO_WSTRING     *)
    (* может дать много знаков после запятой) возможна обрезка в конце       *)
    (* строки при длинных значениях. Если увидишь обрыв текста — увеличивай.*)
    aFountainLog       : ARRAY[1..60] OF WSTRING(60);
    iFountainLogCount  : INT;   // сколько записей реально заполнено (0..60)

    (* === ДДЮТ:НОВОЕ === Единый пароль для очистки ОБОИХ журналов        *)
    (* (ПЧ и фонтана) — числовой, проверяется в ST-коде через встроенный   *)
    (* элемент OwenVisu LoginOnlyPassWithKeysOwen. RETAIN — не теряется    *)
    (* при пропадании питания. Поменяй значение под себя (это заводское    *)
    (* значение-пример, не оставляй в эксплуатации).                       *)
    iAdminPassCorrect : INT := 1234;

    (* ===== ГЛАВНЫЕ ТУМБЛЕРЫ С ЭКРАНА ====================== *)
    xVseSist : BOOL := TRUE;
    (* === ДДЮТ:ИЗМЕНЕНО (единый селектор режимов) ===          *)
    (* Вместо двух раздельных элементов (тумблер разрешения +    *)
    (* отдельная кнопка ручного пуска) — один 3-позиционный      *)
    (* выбор на экране, который сам раскладывается на пару       *)
    (* (Enable, ManualForce). Раскладка — в PRG_Fountain.st,      *)
    (* блок 2а. Значения:                                        *)
    (*   0 = Ручной пуск (принудительно вкл, минуя автоматику)   *)
    (*   1 = Выкл (запрет) — значение по умолчанию для ЛЮБОГО     *)
    (*       некорректного индекса тоже трактуется как "выкл"    *)
    (*   2 = Авто (штатная логика с учётом всех условий)         *)
    iPumpSelect : INT := 2;   // насосы фонтана: 0=ручной,1=выкл,2=авто
    xNfEnable : BOOL := TRUE;

    (* ===== === ДДЮТ:УДАЛИТЬ — УСТАВКИ УРОВНЯ В СМ (AI1) ===== *)
    (* Уровень теперь дискретный, пороги в см не нужны.          *)
    (*
    rLevelOverflow   : REAL := 94.0;
    rLevelNorm       : REAL := 92.5;
    rLevelRefill     : REAL := 91.5;
    rLevelEmergency1 : REAL := 88.0;
    rLevelEmergency2 : REAL := 60.0;
    sLevelOverflow : WSTRING := "Уровень Перелив";
    sLevelNorm : WSTRING := "Уровень Норма";
    sLevelRefill : WSTRING := "Уровень Подпитка";
    sLevelEmergency1 : WSTRING := "Уровень Аварийный 1";
    sLevelEmergency2 : WSTRING := "Уровень Перелив Аварийный 2";
    *)

    (* ===== === ДДЮТ:ИЗМЕНЕНО — УРОВЕНЬ, КОНФИГУРИРУЕМЫЙ 2 ИЛИ 3   *)
    (* ДАТЧИКА (с экрана, кнопками/тумблером) ================= *)
    (* iLevelSensorCountPending = 2: датчики Уровень1 (DI7) и Уровень2*)
    (* (DI8).                                                        *)
    (*   Уровень1=0 (подтверждено) → СУХОЙ ХОД (запрет всего).     *)
    (*   Уровень1=1 И Уровень2=0 (подтверждено) → СТАРТ добора.    *)
    (*   Уровень2=1 (подтверждено) → "хватит", ПОСЛЕ доп.задержки  *)
    (*   iRefillOffDelayMin/Sec — СТОП добора.                     *)
    (* iLevelSensorCountPending = 3: датчики Уровень1 (DI7), Уровень2*)
    (* (DI8), Уровень3 (DI12).                                      *)
    (*   Уровень1=0 (подтверждено) → СУХОЙ ХОД (запрет всего) —     *)
    (*   РОЛЬ ТА ЖЕ, что и в режиме на 2 датчика.                   *)
    (*   Уровень2=0 (подтверждено) → СТАРТ добора (та же роль,      *)
    (*   что у Уровня2 в режиме на 2 датчика).                      *)
    (*   Уровень3=1 (подтверждено) → "хватит", ПОСЛЕ доп.задержки   *)
    (*   — СТОП добора (роль, которую в 2-датчиковом режиме играет  *)
    (*   сам Уровень2).                                             *)
    (* Итог: Уровень1 везде = сухой ход. Уровень2 везде = старт      *)
    (* добора. Разница только в том, ОТКУДА берётся сигнал "хватит":*)
    (* в 2-датчиковом режиме — снова Уровень2 (=1), в 3-датчиковом  *)
    (* — отдельный Уровень3.                                        *)
    (* === ДДЮТ:ИЗМЕНЕНО === Раньше было две переменные (Pending +   *)
    (* подтверждённая, с диалогом PIN-подтверждения в коде). Убрано  *)
    (* по твоей просьбе — защита от случайной записи теперь делается *)
    (* штатными средствами CODESYS (права доступа/пароль на элемент  *)
    (* визуализации при записи переменной), отдельная ST-логика для  *)
    (* этого не нужна. Осталась ОДНА переменная, пишется с экрана     *)
    (* напрямую, используется везде по коду как есть.                *)
    iLevelSensorCountPending : INT := 2;   // 2 или 3, пишется с экрана напрямую

    (* === ДДЮТ:УДАЛИТЬ === "потолок времени" был временной заменой   *)
    (* системы попыток (см. tRefillDurHours/tBetweenRefillHours/       *)
    (* iRefillAttemptsMax выше) — вернул как было в Саки, эта одиночная*)
    (* уставка больше не нужна.                                        *)
    (*
    iRefillMaxDurationMin : INT := 90;
    *)

    (* Гистерезис (антидребезг) КАЖДОГО датчика — свой, все         *)
    (* редактируются с экрана. По умолчанию 20 сек.                 *)
    tLevel1DebounceSec : INT := 20;  // Уровень1 (сухой ход)
    tLevel2DebounceSec : INT := 20;  // Уровень2 (старт добора; и стоп в режиме 2 датчика)
    tLevel3DebounceSec : INT := 20;  // Уровень3 (стоп добора, ТОЛЬКО режим 3 датчика)

    (* Доп. задержка ВЫКЛЮЧЕНИЯ добора после того, как "хватит"      *)
    (* подтверждено гистерезисом — чтобы не дёргать клапан сразу.   *)
    (* Задаётся в минутах+секундах с экрана. По умолчанию 2 мин 0с. *)
    (* Если поставить 0:00 — выключение происходит сразу (без доп.  *)
    (* выдержки), работает в обоих режимах (2 и 3 датчика) одинаково.*)
    iRefillOffDelayMin : INT := 2;
    iRefillOffDelaySec : INT := 0;

    (* === ДДЮТ:УДАЛИТЬ — ПАРАМЕТРЫ ЗАСЛОНКИ ПО КОНЦЕВИКАМ =========*)
    (* Не применимы — на ДДЮТ у заслонки нет концевиков/реле         *)
    (* направления, только команда клапана.                         *)
    (*
    tDamperTimeoutSec   : INT := 60;
    tOverflowDelaySec   : INT := 60;
    tLevelBlockDelaySec : INT := 10;
    tDamperConfirmSec : INT := 20;
    *)

    (* Смещение часового пояса от UTC, сек. Крым/МСК = +3ч=10800.*)
    iTimeZoneOffsetSec : INT := 10800;

    (* === КОРРЕКЦИЯ УХОДА ЧАСОВ === RTC уходит вперёд ~15с/сутки. *)
    (* Раз в сутки в заданный час вычитаем iTimeDriftCorrSec секунд  *)
    (* из RTC. Вся логика — в PRG_TimeCorrect. Все параметры RETAIN, *)
    (* правятся с экрана.                                            *)
    xTimeDriftCorrEnable : BOOL := TRUE;   // включить авто-коррекцию
    iTimeDriftCorrSec    : INT  := 15;     // на сколько секунд отвести RTC назад
    iTimeDriftCorrHour   : INT  := 3;      // в котором часу (местное) применять, 0..23
    xTimeDriftCorrNow    : BOOL := FALSE;  // ручной триггер "скорректировать сейчас"
    iTimeDriftCorrCount  : INT;            // счётчик выполненных коррекций (диагностика)
    sTimeDriftLast       : WSTRING(30);    // дата последней коррекции (для экрана)

    (* === ЖУРНАЛ АВАРИЙ НА SD-КАРТУ (PRG_AlarmLogSD) ============== *)
    (* SD на СПК монтируется в /mnt/ufs/media/mmcblk0p1/ (док ОВЕН    *)
    (* «Архивация — СПК»). Карта: FAT16/FAT32, стиль разделов MBR.    *)
    (* Требуется библиотека CAA File в дереве проекта.               *)
    (* По фронту каждой аварии дописывается строка                    *)
    (*   "чч:мм дд.мм.гггг - <название>" (WSTRING/UTF-16LE) в файл.   *)
    xAlarmLogSDEnable : BOOL := TRUE;                                         // вкл/выкл запись на SD (все 3 журнала)
    sAlarmLogPath     : STRING(80) := '/mnt/ufs/media/mmcblk0p1/alarms.log';      // журнал АВАРИЙ
    sPumpLogPath      : STRING(80) := '/mnt/ufs/media/mmcblk0p1/pump_changes.log'; // журнал изменений ПЧ
    sSetpointLogPath  : STRING(80) := '/mnt/ufs/media/mmcblk0p1/setpoints.log';   // журнал изменений уставок

    iUvNfMinRunMin : INT := 20;   // мин. непрерывной работы НФ для включения УФ, мин (перепроверить)

    (* === ДДЮТ:ВОЗВРАЩЕНО — СИСТЕМА ПОПЫТОК ДОБОРА === *)
    (* Была помечена "устарела" и заменена простым потолком времени  *)
    (* (xRefillMaxDurationAlarm) — но это было неверно: одна неудачная *)
    (* попытка (например, временно нет воды в городском водопроводе) *)
    (* не должна сразу давать аварию. Возвращена логика из Саки:      *)
    (* пробуем добраться tRefillDurHours; если не вышло — пауза       *)
    (* tBetweenRefillHours, новая попытка; после iRefillAttemptsMax   *)
    (* неудачных попыток подряд — авария, до ручного сброса.          *)
    (* xRefillMaxDurationAlarm/iRefillMaxDurationMin — УДАЛЕНЫ,       *)
    (* эта система их полностью заменяет.                             *)
    tRefillDurHours     : INT := 2;   // время на одну попытку добора, часы
    tBetweenRefillHours : INT := 12;  // пауза между неудачными попытками, часы
    iRefillAttemptsMax  : INT := 5;   // макс. число неудачных попыток подряд

    (* === ДДЮТ:УДАЛИТЬ — пороги сливного бака (нет ямы слива) === *)
    (*
    rSlivPolivOnCm : REAL := 5.0;
    rSlivDoborOnCm : REAL := 20.0;
    rSlivNormaPolivCm : REAL := 30.0;
    *)

    (* ===== ДОЗАЦИЯ pH — ТОЛЬКО РАЗРЕШЕНИЕ (без таймера) ==== *)
    (* === ДДЮТ:ИЗМЕНЕНО (единый селектор) — см. пояснение у   *)
    (* iPumpSelect выше. Раскладка в PRG_Fountain.st блок 2а.   *)
    iPhSelect : INT := 2;   // pH: 0=ручной,1=выкл,2=авто

    (* ===== ДОЗАЦИЯ АЛЬГИЦИД — === ДДЮТ:ИЗМЕНЕНО (round 3), реальные значения === *)
    iAlgSelect        : INT := 2;   // альгицид: 0=ручной,1=выкл,2=авто
    rAlgDoseMlPerDay  : REAL := 66.0;     // суточная доза, мл (ДДЮТ)
    rAlgFlowMlPerHour : REAL := 1125.0;   // расход насоса, мл/ч (ДДЮТ)


    (* ===== ДОЗАЦИЯ БИОПАГА — === ДДЮТ:ИЗМЕНЕНО (round 3), реальные значения === *)
    (* ВНИМАНИЕ — МОЯ ИНТЕРПРЕТАЦИЯ ЧИСЕЛ, ПРОВЕРЬ:                *)
    (* Ты написал расход "1.125 и 1.154" без единиц. Для альгицида *)
    (* уже подтверждено 1125 мл/ч (совпадает с "1.125" при чтении   *)
    (* точки как разделителя тысяч). По той же логике "1.154"       *)
    (* прочитано как 1154 мл/ч (а не буквально 1.154 мл/ч — при     *)
    (* таком мизерном расходе доза 33 мл выдавалась бы ~29 часов,    *)
    (* что маловероятно). Если я неправильно понял и расход         *)
    (* биопага ДЕЙСТВИТЕЛЬНО 1.154 мл/ч (не 1154) — поменяй ниже.   *)
    iBioSelect        : INT := 2;   // биопаг: 0=ручной,1=выкл,2=авто
    rBioDoseMlPerDay  : REAL := 33.0;     // суточная доза, мл (ДДЮТ)
    rBioFlowMlPerHour : REAL := 1154.0;   // расход насоса, мл/ч (ДДЮТ) — СВЕРИТЬ, см. выше

    (* ===== ОКНО ИСПРАВНОСТИ ФИЛЬТРАЦИИ ==================== *)
    iFilterMinRunMin   : INT := 30;    // порог наработки НФ, мин (перепроверить)
    iFilterWindowHours : INT := 12;    // (устар., не используется)
    iNfHealthyWindowMin : INT := 0;

    (* === ДДЮТ:НОВОЕ — счётчик промывок НФ (двухстадийный алгоритм,   *)
    (* см. блок 4а PRG_Fountain.st). RETAIN — переживает пропадание     *)
    (* питания, как и остальные счётчики/журналы в проекте.             *)
    iNfLastOnHour  : INT;   // время последнего включения НФ
    iNfLastOnMin   : INT;
    iNfLastOnDay   : INT;
    iNfLastOnMonth : INT;
    iNfLastOnYear  : INT;
    iNfFlushStage  : INT;   // 0=ждём часть 1, 1=часть 1 выполнена, ждём часть 2
    xNfFlushReady  : BOOL := TRUE;  // защита от многократного счёта подряд
    iNfFlushCount  : INT;   // счётчик завершённых промывок (обе части)
    iNfFlushHour   : INT;   // время последней завершённой промывки
    iNfFlushMin    : INT;
    iNfFlushDay    : INT;
    iNfFlushMonth  : INT;
    iNfFlushYear   : INT;

    iNfRunMinAccum    : INT;
    iNfRunSecAccum    : DINT;
    iNfHealthySecLeft : DINT;    // (устар., не исп.)
    iNfHealthyHoursLeft : INT;   // (устар., не исп.)
    iNfHealthyMinLeft   : INT;   // (устар., не исп.)
    xNfProven         : BOOL;    // (устар., не исп.)
    xNfWorkPrev       : BOOL;    // === ДДЮТ:РЕАКТИВИРОВАНО === детект фронта для счётчика промывок (было "не исп.")
    iNfContinuousRunHour : INT;
    iNfContinuousRunMin  : INT;
    iNfContinuousRunSec  : INT;

    (* === ДДЮТ:НОВОЕ — счётчик промывок НФ (двухстадийный алгоритм) === *)
