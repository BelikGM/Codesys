    (* === ДДЮТ:ИЗМЕНЕНО (round 2) === Раньше у света и насосов было   *)
    (* по 4 ОДИНАКОВЫХ положения (полная симметрия). Теперь — РАЗНАЯ   *)
    (* кодировка, ВНИМАТЕЛЬНО:                                         *)
    (*   СВЕТ (4 положения):                                           *)
    (*     0 = Авто  — вкл. по фиксированному времени будни/выходные   *)
    (*         (iLightOnHourWeekday и т.д. ниже), выкл. — общий         *)
    (*         Off_Hour/Minute                                          *)
    (*     1 = Вкл   — горит постоянно, не выключается никогда          *)
    (*     2 = Выкл  — не включается никогда                            *)
    (*     3 = Астро — вкл. по расчёту заката (fbSunset), выкл. — тот   *)
    (*         же общий Off_Hour/Minute                                 *)
    (*   НАСОСЫ (3 положения — БЕЗ "Астро", убрали по факту, оказалось  *)
    (*   ненужным для насосов):                                         *)
    (*     0 = Авто  — вкл. по фиксированному времени (iPumpOnHourWeekday*)
    (*         и т.д.), выкл. — тот же общий Off_Hour/Minute            *)
    (*     1 = Вкл   — работает постоянно, не выключается никогда       *)
    (*     2 = Выкл  — не включается никогда                            *)
    (* В любом случае внешний селектор (iLightSelect/iPumpSelect)      *)
    (* должен быть = 2 ("Авто"), иначе эти переключатели ни на что     *)
    (* не влияют — см. блок 2а PRG_Fountain.st.                        *)
    (* ДЕФОЛТ СВЕТА = 3 (Астро) — сохраняем изначально задуманное      *)
    (* поведение "по умолчанию свет идёт по закату". ВАЖНО: это НЕ 0 — *)
    (* в новой кодировке 0 означает "Авто" (фиксированное время), это   *)
    (* другое поведение. Легко перепутать при переносе, если менять     *)
    (* кодировку не глядя на смысл дефолта.                             *)
    iLightScheduleMode : INT := 3;   // свет: 0=Авто,1=Вкл,2=Выкл,3=Астро (дефолт: по закату)
    iPumpScheduleMode  : INT := 0;   // насосы: 0=Авто,1=Вкл,2=Выкл (дефолт: по времени)

    iLightOnHourWeekday   : INT := 18;   // ручное расписание света: включение, будни
    iLightOnMinuteWeekday : INT := 0;
    iLightOnHourWeekend   : INT := 18;   // ручное расписание света: включение, выходные
    iLightOnMinuteWeekend : INT := 0;

    iPumpOnHourWeekday    : INT := 8;    // расписание насосов: включение, будни (база 8:00)
    iPumpOnMinuteWeekday  : INT := 0;
    iPumpOnHourWeekend    : INT := 8;    // расписание насосов: включение, выходные (база 8:00)
    iPumpOnMinuteWeekend  : INT := 0;

