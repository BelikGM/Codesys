    (* блок 11). По умолчанию совпадает с rSunLongitude — чтобы на     *)
    (* первом холодном старте НЕ переписать корректный дефолт          *)
    (* iChoseTimeZone=14 (+3, Москва) на неверный (см. пояснение там). *)
    rSunLongitudePrev     : REAL := 33.52276;
    (* === ДДЮТ:ИЗМЕНЕНО === часовой пояс теперь выбирается         *)
    (* КОМБОБОКСОМ через FB_TimeZoneSelect (индекс 0-23 → смещение  *)
