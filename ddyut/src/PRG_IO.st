(* ============================================================ *)
(* PRG_IO — ЧТЕНИЕ входов МВ110 + безопасная инициализация МУ110 *)
(* ============================================================ *)
(* === ДДЮТ:ИЗМЕНЕНО (порядок вызова) === Сборка маски выходов   *)
(* wMU110_Outputs вынесена в отдельный POU PRG_IO_Write, который  *)
(* вызывается в PLC_PRG ПОСЛЕ PRG_Fountain — маска берёт xDO[]    *)
(* текущего цикла, а не прошлого (была задержка на 1 скан).       *)
(* Здесь остались только чтение xDI[] и безопасная инициализация. *)
(* === ДДЮТ:ИЗМЕНЕНО — НОВАЯ КАРТА ВХОДОВ/ВЫХОДОВ ===          *)
(* Объект: фонтан ДДЮТ. COM1: МВ110-16Д + МУ110-16Р.           *)
(* Аналогового модуля МВ110-8А НЕТ. Резерва полива НЕТ.        *)
(* Уровень воды — два дискретных входа DI7 (нижний) / DI8       *)
(* (верхний), а не 4-20мА.                                     *)
(*                                                              *)
(* КАРТА DI (МВ110-16Д):                                       *)
(*   DI1  ПЧ1 насос фонтана (работа)                           *)
(*   DI2  ПЧ2 насос фонтана (работа)                           *)
(*   DI3  разрешение работы частотников                        *)
(*   DI4  контактор УФ (УФ начал работу)                       *)
(*   DI5  контактор фильтр.насоса (наработка 30/20 мин)        *)
(*   DI6  реле СУХОГО ХОДА (1 = вода есть)                     *)
(*   DI7  УРОВЕНЬ 1 нижний  (0 = нужен добор)                  *)
(*   DI8  УРОВЕНЬ 2 верхний (1 = стоп добора)                  *)
(*   DI9  подтверждение работы pH                              *)
(*   DI10 подтверждение работы биопаг                          *)
(*   DI11 подтверждение работы альгицид                        *)
(*   DI12..DI16 свободны                                       *)
(*                                                              *)
(* КАРТА DO (МУ110-16Р):                                       *)
(*   DO1  свет | DO2 лампа аварии | DO9 насосы фонтана         *)
(*   DO11 клапан добора | DO13 сухой ход(?) | DO14 альгицид    *)
(*   DO15 биопаг | DO16 pH | остальные FALSE                  *)
(* Формирование xDO[] — в PRG_Fountain (блок 17).             *)
(* ============================================================ *)
PROGRAM PRG_IO
VAR
    i : INT;
    tonMU110SafeInit   : TON;
    xMU110SafeInitDone : BOOL := FALSE;
    tonMV110Hold       : TON;          // удержание входов при сбое связи МВ110
    tDI_Hold           : TIME := T#10S; // время удержания входов
END_VAR
(* Безопасное состояние МУ110: через 3 сек после старта         *)
(* однократно взводим триггер записи (все выходы=0 при потере   *)
(* связи мастер↔МУ110).                                         *)
tonMU110SafeInit(IN := NOT xMU110SafeInitDone, PT := T#3S);
IF tonMU110SafeInit.Q AND NOT xMU110SafeInitDone THEN
    xMU110_WriteSafe   := TRUE;
    xMU110SafeInitDone := TRUE;
ELSE
    xMU110_WriteSafe := FALSE;
END_IF;

(* Входы МВ110 → xDI[1..16]. Удержание последнего значения при   *)
(* кратком сбое связи (tDI_Hold). Логика не меняется.          *)
tonMV110Hold(IN := xMV110_Error, PT := tDI_Hold);

IF xMV110_Error AND tonMV110Hold.Q THEN
    FOR i := 1 TO cDI_Count DO
        xDI[i] := FALSE;
    END_FOR;
ELSIF NOT xMV110_Error THEN
    FOR i := 1 TO cDI_Count DO
        xDI[i] := (wMV110_Inputs AND SHL(WORD#1, INT_TO_BYTE(i - 1))) <> WORD#0;
    END_FOR;
END_IF;

