(* ============================================================ *)
(* PRG_TimeCorrect — КОРРЕКЦИЯ УХОДА СИСТЕМНЫХ ЧАСОВ (RTC)      *)
(* ============================================================ *)
(* RTC контроллера уходит вперёд. Один раз в НОВЫЙ календарный    *)
(* день (начиная с часа iTimeDriftCorrHour) отводим RTC назад на  *)
(* iTimeDriftCorrSec секунд.                                     *)
(*                                                              *)
(* ⚠️ ГРАБЛИ 03.08.2026 (часы уехали на -3 ч за загрузку):        *)
(* На СПК SysTimeRtcGet и SysTimeRtcSet работают в РАЗНЫХ         *)
(* системах отсчёта: Get отдаёт UTC, а Set трактует аргумент как  *)
(* МЕСТНОЕ время (рантайм сам вычитает часовой пояс). Прочитали   *)
(* UTC → записали обратно → потеряли ровно 3 часа (10800 с).      *)
(* Плюс iLastCorrDay = RETAIN обнулялся холодным сбросом в -1,    *)
(* поэтому коррекция срабатывала на ПЕРВОМ скане каждой загрузки: *)
(* 3 загрузки = -9 часов.                                        *)
(*                                                              *)
(* ЧТО СДЕЛАНО:                                                  *)
(* 1) Холодный старт (iLastCorrDay=-1) больше НЕ корректирует —   *)
(*    просто запоминает текущий день. Загрузка ≠ коррекция.       *)
(* 2) После записи на СЛЕДУЮЩЕМ скане RTC читается обратно и      *)
(*    сверяется с ожидаемым. Расхождение >60 с копится в RETAIN   *)
(*    diRtcSetBias и вычитается из всех последующих записей —     *)
(*    перекос Set/Get измеряется самим ПЛК и компенсируется.      *)
(*    Тут же делается повторная запись, т.е. часы возвращаются    *)
(*    на место в том же цикле, а не остаются уехавшими.           *)
(* 3) Если после 2 попыток не сошлось — авто-коррекция глушится   *)
(*    (xTimeDriftCorrEnable := FALSE) и на экран идёт текст.      *)
(* 4) Шаг коррекции жёстко ограничен 600 с: одним разом часы      *)
(*    не сдвинуть больше чем на 10 минут.                        *)
(*                                                              *)
(* Ставить время из приложения ПЛК МОЖНО — не защищённая          *)
(* операция. Вызывается в PLC_PRG ПОСЛЕ PRG_Fountain.             *)
(*                                                              *)
(* Сигнатура (подтверждена по библиотеке SysTimeRtc проекта):     *)
(*   SysTimeRtcSet(ulTimestamp : DWORD) : RTS_IEC_RESULT          *)
(* ============================================================ *)
PROGRAM PRG_TimeCorrect
VAR RETAIN
    iLastCorrDay : INT  := -1;   // день месяца последней коррекции (1 раз в сутки, переживает ребут)
    diRtcSetBias : DINT := 0;    // измеренный перекос SysTimeRtcSet относительно SysTimeRtcGet, сек
END_VAR
VAR
    dwUtcRaw   : DWORD;   // сырое показание RTC этого скана
    dwTarget   : DWORD;   // какое значение хотим видеть в RTC после записи
    rtcRes     : DWORD;
    xDoCorrect : BOOL;
    xVerify    : BOOL;    // на следующем скане проверить результат записи
    iRetry     : INT;     // счётчик повторных попыток записи
    diDelta    : DINT;    // фактическое отклонение от ожидаемого, сек
    diStep     : DINT;    // ограниченный шаг коррекции, сек
END_VAR

dwUtcRaw := SysTimeRtcGet(pResult := rtcRes);

(* ============================================================ *)
(* 1. ПРОВЕРКА ПРЕДЫДУЩЕЙ ЗАПИСИ (следующий скан после Set)      *)
(* ============================================================ *)
IF xVerify THEN
    xVerify := FALSE;
    diDelta := DWORD_TO_DINT(dwUtcRaw) - DWORD_TO_DINT(dwTarget);

    IF (diDelta > 60) OR (diDelta < -60) THEN
        (* Часы встали НЕ туда. Копим измеренный перекос Set/Get. *)
        diRtcSetBias := diRtcSetBias + diDelta;

        IF iRetry < 2 THEN
            (* Повторная запись с учётом перекоса — возвращаем часы на место *)
            iRetry := iRetry + 1;
            rtcRes := SysTimeRtcSet(DINT_TO_DWORD(DWORD_TO_DINT(dwTarget) - diRtcSetBias));
            xVerify := TRUE;
        ELSE
            (* Не лечится — глушим авто-коррекцию, чтобы не портить часы *)
            xTimeDriftCorrEnable := FALSE;
            sTimeDriftLast       := "ОШИБКА записи RTC — коррекция ВЫКЛ";
            iRetry               := 0;
        END_IF;
    ELSE
        (* Записалось верно *)
        iRetry              := 0;
        iTimeDriftCorrCount := iTimeDriftCorrCount + 1;
        sTimeDriftLast      := sCurrentDateStr;   // дата последней коррекции для экрана
    END_IF;
END_IF;

(* ============================================================ *)
(* 2. КОГДА КОРРЕКТИРОВАТЬ                                       *)
(* ============================================================ *)
xDoCorrect := FALSE;

(* Холодный старт / первый запуск: день неизвестен — НЕ корректируем,  *)
(* только запоминаем текущий день. Иначе каждая загрузка с холодным     *)
(* сбросом сдвигала бы часы (см. грабли в шапке).                      *)
IF (iLastCorrDay < 1) AND (iCurrentDay >= 1) THEN
    iLastCorrDay := iCurrentDay;
END_IF;

(* Авто: раз в новый день, НАЧИНАЯ с часа iTimeDriftCorrHour.        *)
(* Минута НЕ проверяется (окно — весь день от этого часа), поэтому    *)
(* пропуск из-за пропадания питания не страшен: сработает на первом   *)
(* же скане после включения, если день новый и час уже наступил.      *)
(* ⚠️ Час нужен, чтобы вычитание секунд НЕ пересекало полночь: без    *)
(* него (чистый «новый день») коррекция в 00:00 откатывает время в    *)
(* 23:59 прошлого дня → день снова «новый» → бесконечный откат.       *)
(* iTimeDriftCorrHour>=1 (0 не ставить!).                             *)
IF xTimeDriftCorrEnable
   AND (iCurrentDay <> iLastCorrDay)
   AND (iCurrentHour >= iTimeDriftCorrHour) THEN
    xDoCorrect := TRUE;
END_IF;

(* Ручной триггер с экрана — срабатывает один раз *)
IF xTimeDriftCorrNow THEN
    xDoCorrect := TRUE;
END_IF;

(* ============================================================ *)
(* 3. СОБСТВЕННО КОРРЕКЦИЯ                                       *)
(* ============================================================ *)
(* Пока не проверен результат прошлой записи — новую не начинаем *)
IF xDoCorrect AND NOT xVerify THEN
    (* Жёсткий предел шага: одним разом часы не сдвинуть больше 10 мин *)
    diStep := INT_TO_DINT(iTimeDriftCorrSec);
    IF diStep > 600 THEN
        diStep := 600;
    ELSIF diStep < 0 THEN
        diStep := 0;
    END_IF;

    (* Целевое СЫРОЕ значение RTC (в системе отсчёта SysTimeRtcGet) *)
    dwTarget := DINT_TO_DWORD(DWORD_TO_DINT(dwUtcRaw) - diStep);

    (* Пишем с компенсацией измеренного перекоса Set/Get *)
    rtcRes  := SysTimeRtcSet(DINT_TO_DWORD(DWORD_TO_DINT(dwTarget) - diRtcSetBias));

    iRetry            := 0;
    xVerify           := TRUE;   // результат сверим на следующем скане
    iLastCorrDay      := iCurrentDay;
    xTimeDriftCorrNow := FALSE;  // гасим ручной триггер
END_IF;

(* iTimeDriftCorrHour — час-якорь (по умолч. 3), с которого в новый    *)
(* день разрешена коррекция. НЕ ставить 0 (см. предупреждение выше).    *)
(* iTimeDriftCorrSec — на сколько секунд отводить назад (по умолч. 15;  *)
(* поставь 20, если измеренный уход ~20с/сутки). Максимум 600.          *)
(* diRtcSetBias — диагностика: после первой коррекции покажет реальный  *)
(* перекос SysTimeRtcSet (на СПК ожидается -10800 = минус часовой пояс).*)
